<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Zzzz" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_purple_alpha15</item>
        <item name="colorOnPrimaryContainer">@color/brand_purple</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_purple_light</item>
        <item name="colorOnSecondary">@color/text_on_brand</item>

        <!-- Background and Surface colors -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_background</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurfaceVariant">@color/text_sub</item>

        <!-- Border & Outline Colors - FOR VISIBILITY ACROSS ALL SCREENS -->
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <!-- Selection and Cursor colors -->
        <item name="android:textColorHighlight">@color/text_selection_highlight</item>
        <item name="android:colorControlActivated">@color/brand_purple</item>
        <item name="android:textSelectHandle">@color/brand_purple</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Zzzz" parent="Base.Theme.Zzzz" />

    <style name="CircleImageView" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="HeadingStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="PillOption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="MindForge_BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Material3.BottomSheet.Modal</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="ChatFabShape" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="MindForge_Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="dialogCornerRadius">24dp</item>
        <item name="android:background">@drawable/dialog_background</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="shapeAppearanceOverlay">@style/DialogShapeAppearance</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton_Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton_Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButton_Neutral</item>
    </style>

    <style name="DialogShapeAppearance" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="DialogTitleText" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="DialogBodyText" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="DialogButton_Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand_purple</item>
        <item name="rippleColor">@color/brand_purple_alpha15</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="DialogButton_Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_sub</item>
        <item name="rippleColor">@color/brand_purple_alpha15</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DialogButton_Neutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_sub</item>
        <item name="rippleColor">@color/brand_purple_alpha15</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>