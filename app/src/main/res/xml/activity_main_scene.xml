<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Transition
        app:constraintSetEnd="@+id/expanded"
        app:constraintSetStart="@+id/collapsed"
        app:duration="400"
        app:motionInterpolator="easeInOut">
        <OnClick
            app:clickAction="toggle"
            app:targetId="@id/islandContainer" />
    </Transition>

    <ConstraintSet android:id="@+id/collapsed">
        <Constraint
            android:id="@+id/islandContainer"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <CustomAttribute
                app:attributeName="cardCornerRadius"
                app:customDimension="30dp" />
        </Constraint>

        <Constraint
            android:id="@+id/profileImage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintEnd_toEndOf="@id/islandContainer"
            app:layout_constraintStart_toStartOf="@id/islandContainer"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />

        <Constraint
            android:id="@+id/textContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:translationX="30dp"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintStart_toEndOf="@id/profileImage"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />

        <Constraint
            android:id="@+id/btnTheme"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintEnd_toEndOf="@id/islandContainer"
            app:layout_constraintStart_toStartOf="@id/islandContainer"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />

        <Constraint
            android:id="@+id/btnHistory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintEnd_toEndOf="@id/islandContainer"
            app:layout_constraintStart_toStartOf="@id/islandContainer"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />

        <Constraint
            android:id="@+id/btnSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintEnd_toEndOf="@id/islandContainer"
            app:layout_constraintStart_toStartOf="@id/islandContainer"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/expanded">
        <Constraint
            android:id="@+id/islandContainer"
            android:layout_width="340dp"
            android:layout_height="80dp"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <CustomAttribute
                app:attributeName="cardCornerRadius"
                app:customDimension="40dp" />
        </Constraint>

        <Constraint
            android:id="@+id/profileImage"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintStart_toStartOf="@id/islandContainer"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />

        <Constraint
            android:id="@+id/btnSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:alpha="1"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintEnd_toEndOf="@id/islandContainer"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />

        <Constraint
            android:id="@+id/btnHistory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:alpha="1"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintEnd_toStartOf="@id/btnSettings"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />

        <Constraint
            android:id="@+id/btnTheme"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:alpha="1"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintEnd_toStartOf="@id/btnHistory"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />

        <Constraint
            android:id="@+id/textContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@id/islandContainer"
            app:layout_constraintEnd_toStartOf="@id/btnTheme"
            app:layout_constraintStart_toEndOf="@id/profileImage"
            app:layout_constraintTop_toTopOf="@id/islandContainer" />
    </ConstraintSet>

</MotionScene>