<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ConstraintSet android:id="@+id/start">
        <Constraint android:id="@+id/island_bg">
            <Layout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.95" />
        </Constraint>

        <Constraint android:id="@+id/profileImage">
            <Layout
                android:layout_width="45dp"
                android:layout_height="45dp"
                app:layout_constraintBottom_toBottomOf="@id/island_bg"
                app:layout_constraintStart_toStartOf="@id/island_bg"
                app:layout_constraintTop_toTopOf="@id/island_bg"
                android:layout_marginStart="20dp"/>
            <PropertySet android:alpha="1.0" />
        </Constraint>

        <Constraint android:id="@+id/text_group">
            <Layout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@id/profileImage"
                app:layout_constraintStart_toEndOf="@id/profileImage"
                app:layout_constraintTop_toTopOf="@id/profileImage" />
            <PropertySet android:alpha="1.0" />
        </Constraint>

        <Constraint android:id="@+id/icon_group">
            <Layout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="@id/island_bg"
                app:layout_constraintEnd_toEndOf="@id/island_bg"
                app:layout_constraintTop_toTopOf="@id/island_bg" />
            <PropertySet android:alpha="1.0" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@+id/island_bg">
            <Layout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </Constraint>

        <Constraint android:id="@+id/text_group">
            <PropertySet android:alpha="0" />
        </Constraint>

        <Constraint android:id="@+id/icon_group">
            <PropertySet android:alpha="0" />
        </Constraint>

        <Constraint android:id="@+id/profileImage">
            <Layout
                android:layout_width="45dp"
                android:layout_height="45dp"
                app:layout_constraintBottom_toBottomOf="@id/island_bg"
                app:layout_constraintStart_toStartOf="@id/island_bg"
                app:layout_constraintEnd_toEndOf="@id/island_bg"
                app:layout_constraintTop_toTopOf="@id/island_bg" />
        </Constraint>
    </ConstraintSet>

    <Transition
        app:constraintSetEnd="@id/end"
        app:constraintSetStart="@id/start"
        app:duration="500">
        <OnSwipe
            app:touchAnchorId="@+id/scrollView"
            app:touchAnchorSide="top"
            app:dragDirection="dragUp" />
    </Transition>
</MotionScene>