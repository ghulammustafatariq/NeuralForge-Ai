<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupChartType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBar"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bar"
            android:textColor="@color/chip_text_state"
            app:chipBackgroundColor="@color/chip_background_state"
            app:chipStrokeColor="#1A6800FF"
            app:chipStrokeWidth="1.2dp"
            app:chipCornerRadius="24dp"
            app:checkedIconVisible="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLine"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Line"
            android:textColor="@color/chip_text_state"
            app:chipBackgroundColor="@color/chip_background_state"
            app:chipStrokeColor="#1A6800FF"
            app:chipStrokeWidth="1.2dp"
            app:chipCornerRadius="24dp"
            app:checkedIconVisible="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipScatter"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scatter"
            android:textColor="@color/chip_text_state"
            app:chipBackgroundColor="@color/chip_background_state"
            app:chipStrokeColor="#1A6800FF"
            app:chipStrokeWidth="1.2dp"
            app:chipCornerRadius="24dp"
            app:checkedIconVisible="false" />
    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:id="@+id/chartView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />
</LinearLayout>
