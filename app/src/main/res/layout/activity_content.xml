<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg_professional">

    <!-- Premium Top Glow Fade -->
    <View
        android:id="@+id/topFadeView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/bg_top_faded_theme"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Premium Frosted Glass Dynamic Island Top Bar -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dynamic_island_perfect"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.94">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_back_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/brand_purple"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvContentTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="Neural Synthesis"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnOverflow"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnOverflow"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_overflow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/brand_purple"
                android:contentDescription="@string/more_options" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Professional Horizontal Tab Navigation -->
    <HorizontalScrollView
        android:id="@+id/navScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tab0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/brand_purple_alpha15"
                android:paddingHorizontal="22dp"
                android:paddingVertical="11dp"
                android:text="Map"
                android:textColor="@color/brand_purple"
                android:fontFamily="sans-serif-black"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"/>

            <TextView
                android:id="@+id/tab1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/surface_input"
                android:paddingHorizontal="22dp"
                android:paddingVertical="11dp"
                android:text="Explanation"
                android:textColor="@color/text_sub"
                android:fontFamily="sans-serif-bold"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tab2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/surface_input"
                android:paddingHorizontal="22dp"
                android:paddingVertical="11dp"
                android:text="Formulas"
                android:textColor="@color/text_sub"
                android:fontFamily="sans-serif-bold"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tab3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/surface_input"
                android:paddingHorizontal="22dp"
                android:paddingVertical="11dp"
                android:text="Code"
                android:textColor="@color/text_sub"
                android:fontFamily="sans-serif-bold"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tab4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/surface_input"
                android:paddingHorizontal="22dp"
                android:paddingVertical="11dp"
                android:text="Charts"
                android:textColor="@color/text_sub"
                android:fontFamily="sans-serif-bold"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Fragment Display Area -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navScrollView" />

    <!-- AI Interactor FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:contentDescription="Chat"
        app:srcCompat="@drawable/ic_chat_bubble"
        app:tint="@color/text_on_brand"
        app:backgroundTint="@color/brand_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ChatFabShape"
        app:elevation="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>