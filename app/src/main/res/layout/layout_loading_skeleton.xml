<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Top Identifier Skeleton -->
            <View
                android:layout_width="90dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/surface_input" />

            <!-- Heading Skeleton -->
            <View
                android:layout_width="200dp"
                android:layout_height="24dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/divider" />

            <!-- Content Paragraph Skeletons -->
            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/surface_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/surface_input" />

            <View
                android:layout_width="240dp"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/surface_input" />

            <!-- Feature Illustration/Chart Skeleton -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/surface_input"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp" />

            <!-- Action Area Skeleton -->
            <View
                android:layout_width="140dp"
                android:layout_height="44dp"
                android:layout_marginTop="32dp"
                android:layout_gravity="end"
                android:background="@drawable/bg_pill_purple"
                android:backgroundTint="@color/surface_input" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
