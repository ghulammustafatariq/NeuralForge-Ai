<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/glass_input_bg">

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/node_detail_title"
        android:textColor="@color/brand_purple"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:id="@+id/tvDetailContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Detailed neural insight regarding this specific knowledge node..."
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:fontFamily="sans-serif-medium" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseDetail"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:text="@string/close"
        android:textColor="@color/text_on_brand"
        android:textSize="17sp"
        android:fontFamily="sans-serif-black"
        app:backgroundTint="@color/brand_purple"
        app:cornerRadius="32dp"
        app:elevation="4dp" />

</LinearLayout>