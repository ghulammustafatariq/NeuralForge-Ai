<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Ambient Floating Shadow: Creates high-end elevation and depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <solid android:color="#66000000" />
        </shape>
    </item>

    <!-- 2. The Main Chassis: Pure OLED Midnight Black -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
            <corners android:radius="40dp" />
        </shape>
    </item>

    <!-- 3. High-Precision Diamond-Cut Bezel: Ultra-thin satin highlight around the perimeter -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <stroke android:width="1.2dp" android:color="#2BFFFFFF" />
        </shape>
    </item>

    <!-- 4. Liquid Glass Reflection: Simulating the curve of a physical screen surface -->
    <item android:top="2dp" android:left="18dp" android:right="18dp" android:bottom="36dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- 5. Internal Structural Highlight: A subtle secondary rim at the bottom -->
    <item android:top="44dp" android:left="35dp" android:right="35dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="90"
                android:startColor="#1AFFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>